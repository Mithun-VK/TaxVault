# Same-origin deployment (nginx reverse-proxying /api on one domain - see
# nginx/, docker-compose.selfhost.yml): a relative path works with zero CORS
# configuration, because the browser never leaves this origin.
VITE_API_BASE_URL=/api/v1

# On Vercel, frontend and backend are two separate projects on two separate
# domains, so this must be the BACKEND project's own absolute URL instead -
# e.g. https://taxvault-api.vercel.app/api/v1. The backend's CORS_ORIGINS must
# then list this frontend project's domain, or every request gets CORS-blocked.
# Set the real value in the frontend Vercel project's dashboard (Settings >
# Environment Variables) rather than committing it here. See VERCEL_DEPLOYMENT.md.
# VITE_API_BASE_URL=https://taxvault-api.vercel.app/api/v1

# Only needed for local `npm run dev` - proxies /api/* to this backend so the
# relative VITE_API_BASE_URL above resolves. Unused in a production build.
VITE_API_BACKEND_URL=http://127.0.0.1:8000

VITE_ENABLE_MOCKS=false
VITE_APP_NAME=TaxVault
VITE_APP_VERSION=3.0.0
