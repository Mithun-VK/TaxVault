# ─────────────────────────────────────────────────────────────────────────────
# TaxVault self-hosted config — copy to backend/.env.selfhost and fill in.
#
#   cp backend/.env.selfhost.example backend/.env.selfhost
#
# Read twice: once by docker compose (--env-file) to interpolate ${...} in
# docker-compose.selfhost.yml, and once by each container as its environment.
#
# Do NOT use a '$' in any password here — compose treats it as interpolation.
# Do NOT quote values; compose passes quotes through literally to the container.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose-level (host ports, DB bootstrap) ─────────────────────────────────
POSTGRES_USER=taxvault
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CHANGE_ME_no_dollar_signs
POSTGRES_DB=taxvault

# Host ports. Defaults dodge the dev stack (5432) and whatever owns 8000.
WEB_PORT=8080
API_HOST_PORT=8001
POSTGRES_HOST_PORT=5433

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing this invalidates every issued token and forces all users to log in.
SECRET_KEY=CHANGE_ME_64_hex_chars

# ── Database ─────────────────────────────────────────────────────────────────
# 'postgres' and 'redis' are the compose service names, resolved on the internal
# network. Passwords must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://taxvault:CHANGE_ME_no_dollar_signs@postgres:5432/taxvault
DIRECT_DATABASE_URL=postgresql+asyncpg://taxvault:CHANGE_ME_no_dollar_signs@postgres:5432/taxvault

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Real Redis in-stack, so refresh-token revocation on logout actually works.
ENABLE_TOKEN_BLOCKLIST=true

# ── Origins ──────────────────────────────────────────────────────────────────
# Every URL the app is opened from. In production these also seed the trusted
# Host allowlist, so a missing entry here returns "Invalid host header".
# LAN access: add http://192.168.1.50:8080 (your machine's address).
# Rented server later: replace with https://taxvault.yourdomain.in
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

# ── Document storage ─────────────────────────────────────────────────────────
# Absolute path inside the container, backed by the 'uploads' docker volume.
# Leaving R2_* blank keeps the local-disk path active — that is the point of
# self-hosting, and it means documents live in the volume you back up.
LOCAL_STORAGE_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=taxvault-docs

# ── Notifications (optional — blank disables the channel) ────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@yourdomain.in

# ─── WhatsApp alerts (Twilio) ────────────────────────────────────────────────
# The channel payment reminders actually go out on. Get these from the Twilio
# console; for testing, "Messaging > Try it out > WhatsApp" gives you a sandbox
# sender and a join code. Plain E.164 numbers — the "whatsapp:" prefix is added
# for you. Leave TWILIO_WHATSAPP_TO blank to send to each user's own phone
# number instead of one household number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=TXVALT
MSG91_TEMPLATE_ID=

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
