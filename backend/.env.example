# Set to "production" in prod - enables SECRET_KEY enforcement, hides /docs, etc.
ENVIRONMENT=development
SECRET_KEY=change-me-to-64-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:password@db.xxx.supabase.co:5432/postgres
# Direct (non-pooler) connection used by Alembic migrations. Falls back to
# DATABASE_URL if unset. Point at port 5432 (not the 6543 pooler).
DIRECT_DATABASE_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# Comma-separated allowed browser origins in prod, e.g. https://app.taxvault.in
# On Vercel this MUST list the frontend project's real domain(s) - the two are
# separate origins there (no nginx reverse-proxy putting them on one domain),
# so a wildcard or a missing entry means every browser request gets CORS-blocked.
CORS_ORIGINS=*
FRONTEND_URL=http://localhost:5173
# Enable Redis-backed refresh-token revocation on logout (needs a real Redis)
ENABLE_TOKEN_BLOCKLIST=false

# ─── Vercel-only: replaces Celery beat ───────────────────────────────────────
# Blank everywhere else. On Vercel there is no worker process, so
# docker-compose's `celery beat`/`celery worker` never run there; two Vercel
# Cron Jobs (backend/vercel.json) hit /api/v1/cron/daily-scan and
# /api/v1/cron/overdue-check on the same schedule instead. Set this to a random
# secret in the Vercel project's env vars - Vercel then sends it automatically
# as "Authorization: Bearer <value>" on every cron-triggered request, which the
# routes check for. Generate one the same way as SECRET_KEY.
CRON_SECRET=

R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=taxvault-docs

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@yourdomain.in

# ─── WhatsApp alerts (Twilio) ────────────────────────────────────────────────
# The channel payment reminders actually go out on. Get these from the Twilio
# console; for testing, "Messaging > Try it out > WhatsApp" gives you a sandbox
# sender and a join code. Plain E.164 numbers - the "whatsapp:" prefix is added
# for you. Leave TWILIO_WHATSAPP_TO blank to send to each user's own phone
# number instead of one household number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=TXVALT
MSG91_TEMPLATE_ID=

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

SENTRY_DSN=

# ─── Seeding ──────────────────────────────────────────────────────────────────
# Run:      python scripts/seed_client_data.py
# Dry run:  python scripts/seed_client_data.py --dry-run
# Reset + reseed: python scripts/seed_client_data.py --reset
# Verify:   python scripts/verify_client_data.py
